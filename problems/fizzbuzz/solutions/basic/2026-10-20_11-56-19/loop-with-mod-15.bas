REM ---
REM title: Loop with mod 15
REM author: Cursor Agent <cursoragent@cursor.com>
REM ---
INPUT N
FOR I=1 TO 20
LET M15:=I%15
LET M3:=I%3
LET M5:=I%5
IF I<=N THEN IF M15=0 THEN PRINT "FizzBuzz"
IF I<=N THEN IF M3=0 THEN IF M15<>0 THEN PRINT "Fizz"
IF I<=N THEN IF M5=0 THEN IF M3<>0 THEN PRINT "Buzz"
IF I<=N THEN IF M3<>0 THEN IF M5<>0 THEN PRINT I
NEXT
